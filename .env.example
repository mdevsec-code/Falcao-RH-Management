# Falcão RH: variáveis de ambiente. Copie para .env e preencha.
# NUNCA versione o .env nem cole credenciais reais em documentação.

NODE_ENV=development

# ---------- API ----------
PORT=3333
HOST=127.0.0.1
LOG_LEVEL=info

# PostgreSQL 15+ (recomendado 17). Usuário dono das tabelas: aplica migrações e
# troca para a role falcao_app em cada transação de domínio (docs/SECURITY.md).
# Em produção, use sslmode=require.
DATABASE_URL=postgres://falcao_rh:TROQUE_ESTA_SENHA@127.0.0.1:5432/falcao_rh
DATABASE_POOL_MAX=10

# Segredo das sessões: 32+ caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Endereço público do sistema. Em desenvolvimento, o Vite (5173) faz proxy
# de /api para a API, então os dois apontam para a mesma origem.
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:5173

# ---------- E-mail (convites, aprovações, avisos) ----------
# SMTP do provedor transacional. Amazon SES: smtps://USUARIO:SENHA@email-smtp.sa-east-1.amazonaws.com:465
# Obrigatório em produção. Vazio em desenvolvimento: os e-mails aparecem no log da API.
SMTP_URL=
MAIL_FROM="Falcão RH <nao-responda@seu-dominio.com.br>"

# ---------- Arquivos privados (documentos) ----------
# local: disco do servidor (desenvolvimento). s3: Amazon S3 ou compatível (produção).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=sa-east-1
# Só para provedores compatíveis com S3 (MinIO, R2). Vazio na AWS.
S3_ENDPOINT=

# ---------- Seed de demonstração (apenas desenvolvimento) ----------
# Cria a organização "(DEMO)" com colaboradores, férias, ausências e documentos
# FICTÍCIOS, este administrador e um usuário de cada perfil (rh@, gestor@,
# colaborador@demo.falcao.invalid) com a mesma senha.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
